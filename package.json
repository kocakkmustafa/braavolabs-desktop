{
  "name": "@braavolabs/desktop",
  "version": "0.1.1",
  "packageManager": "pnpm@10.33.0",
  "private": true,
  "description": "Braavolabs Desktop — native multi-model chat & cascade control (Tauri v2). BYOK, self-host, obsidian UI.",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "dev:ui": "vite",
    "tauri": "tauri",
    "tauri:dev": "echo 'human gate: run `pnpm tauri dev` from ventures/braavolabs/desktop (needs a GUI session)'",
    "tauri:build": "tauri build",
    "tauri:build:mac": "tauri build --target universal-apple-darwin",
    "tauri:build:mac:unsigned": "APPLE_SIGNING_IDENTITY=- tauri build --target universal-apple-darwin"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.6"
  }
}
